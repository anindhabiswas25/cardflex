{
  "name": "card-flex",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "check:toolchain": "bash scripts/check-toolchain.sh",
    "build:program": "anchor build",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "verify": "pnpm check:toolchain && pnpm build:program && pnpm lint:rust && pnpm test:rust && pnpm check:fairness",
    "mb-stack": "mb-stack",
    "probe": "pnpm --filter @card-flex/probes probe",
    "roundtrip": "pnpm --filter @card-flex/probes roundtrip",
    "tablepoc": "pnpm --filter @card-flex/probes tablepoc",
    "build:program:devnet-poc": "anchor build -- --features poc-test-deck",
    "privacy-suite": "pnpm --filter @card-flex/probes privacy-suite",
    "check:fairness": "python3 -I scripts/check_fairness_vectors.py",
    "handflow": "pnpm --filter @card-flex/probes handflow"
  },
  "devDependencies": {
    "@magicblock-labs/ephemeral-validator": "1.1.1"
  }
}
