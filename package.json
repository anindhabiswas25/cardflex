{
  "name": "card-flex",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "check:toolchain": "bash scripts/check-toolchain.sh",
    "build:program": "anchor build",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "verify": "pnpm check:toolchain && pnpm build:program && pnpm lint:rust && pnpm test:rust",
    "mb-stack": "mb-stack",
    "probe": "pnpm --filter @card-flex/probes probe"
  },
  "devDependencies": {
    "@magicblock-labs/ephemeral-validator": "1.1.1"
  }
}
