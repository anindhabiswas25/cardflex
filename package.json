{
  "name": "card-flex",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "check:toolchain": "bash scripts/check-toolchain.sh",
    "build:program": "anchor build",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "verify": "pnpm check:toolchain && pnpm build:program && pnpm lint:rust && pnpm test:rust && pnpm check:fairness && pnpm check:rules && pnpm test:sdk && pnpm test:api && pnpm test:admin && pnpm test:keeper && pnpm check:g2",
    "mb-stack": "mb-stack",
    "probe": "pnpm --filter @card-flex/probes probe",
    "build:program:devnet-poc": "anchor build -- --features poc-test-deck",
    "privacy-suite": "pnpm --filter @card-flex/probes privacy-suite",
    "check:fairness": "python3 -I scripts/check_fairness_vectors.py",
    "check:rules": "python3 -I scripts/check_rules_vectors.py",
    "build:wasm": "cargo build -q --release -p fairness-wasm --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/fairness_wasm.wasm packages/client-sdk/wasm/cf_verify.wasm",
    "test:api": "pnpm --filter @card-flex/api test && pnpm --filter @card-flex/api typecheck",
    "api": "pnpm --filter @card-flex/api start",
    "test:admin": "pnpm --filter @card-flex/admin test && pnpm --filter @card-flex/admin typecheck",
    "admin": "pnpm --filter @card-flex/admin cli",
    "test:keeper": "pnpm --filter @card-flex/keeper test && pnpm --filter @card-flex/keeper typecheck",
    "keeper": "pnpm --filter @card-flex/keeper start",
    "keeper-drill": "pnpm --filter @card-flex/keeper drill",
    "lost-drill": "pnpm --filter @card-flex/keeper lost-drill",
    "load-test": "pnpm --filter @card-flex/keeper load",
    "test:sdk": "pnpm build:wasm && pnpm --filter @card-flex/client-sdk test && pnpm --filter @card-flex/client-sdk typecheck",
    "handflow": "pnpm --filter @card-flex/probes handflow",
    "game": "pnpm --filter @card-flex/probes game",
    "reconcile": "pnpm --filter @card-flex/probes reconcile",
    "money": "pnpm --filter @card-flex/probes money",
    "deploy:devnet": "bash scripts/deploy-devnet.sh",
    "check:g2": "cargo test -p fairness-verifier --release -- --ignored",
    "recovery": "pnpm --filter @card-flex/probes recovery"
  },
  "devDependencies": {
    "@magicblock-labs/ephemeral-validator": "1.1.1"
  }
}
